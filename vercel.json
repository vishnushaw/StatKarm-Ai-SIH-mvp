{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js"},
    { "source": "/documents/:path*", "destination": "/api/documents/:path*" },
    { "source": "/quiz/:path*", "destination": "/api/quiz/:path*" },
    { "source": "/competencies/:path*", "destination": "/api/competencies/:path*" },
    { "source": "/igot/:path*", "destination": "/api/igot/:path*" },
    { "source": "/auth/:path*", "destination": "/api/auth/:path*" },
    { "source": "/health", "destination": "/api/health" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  }
}
